# ============================================================
# Dockerfile.contracts — Soroban Contract Builder & CLI
# ============================================================
FROM rust:1-slim-bookworm AS rust-base

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev curl ca-certificates libdbus-1-3 \
 && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        URL="https://github.com/stellar/stellar-cli/releases/download/v28.1.0/stellar-cli-28.1.0-aarch64-unknown-linux-gnu.tar.gz"; \
    else \
        URL="https://github.com/stellar/stellar-cli/releases/download/v28.1.0/stellar-cli-28.1.0-x86_64-unknown-linux-gnu.tar.gz"; \
    fi && \
    curl -L $URL -o /tmp/stellar-cli.tar.gz \
 && tar -xzf /tmp/stellar-cli.tar.gz -C /usr/local/bin \
 && rm /tmp/stellar-cli.tar.gz \
 && stellar --version

RUN rustup target add wasm32-unknown-unknown wasm32v1-none

# ── Stage 1: cargo-chef planner ──────────────────────────────────────────────
FROM rust-base AS cargo-chef-planner
RUN cargo install cargo-chef --version 0.1.68 --locked
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY contracts/escrow/Cargo.toml ./contracts/escrow/
COPY contracts/escrow/src/ ./contracts/escrow/src/
COPY src/ ./src/
RUN cargo chef prepare --recipe-path recipe.json

# ── Stage 2: cargo-chef cook (dependency compilation — cached) ───────────────
FROM rust-base AS cargo-chef-cook
RUN cargo install cargo-chef --version 0.1.68 --locked
WORKDIR /workspace
COPY --from=cargo-chef-planner /workspace/recipe.json ./
RUN cargo chef cook --release --target wasm32-unknown-unknown --recipe-path recipe.json

# ── Stage 3: Contract builder ─────────────────────────────────────────────────
FROM rust-base AS builder
WORKDIR /workspace
COPY --from=cargo-chef-cook /workspace/target ./target
COPY --from=cargo-chef-cook /usr/local/cargo /usr/local/cargo
COPY Cargo.toml Cargo.lock ./
COPY contracts/ ./contracts/
COPY src/ ./src/

# Build the escrow contract as WASM using the official stellar CLI
RUN stellar contract build --package escrow --out-dir /contracts/wasm/

# ── Stage 4: CLI runtime image ────────────────────────────────────────────────
FROM debian:bookworm-slim AS cli
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates libdbus-1-3 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=rust-base /usr/local/bin/stellar /usr/local/bin/stellar
COPY --from=builder /contracts/wasm/ /contracts/wasm/
WORKDIR /contracts
RUN stellar --version || exit 1
CMD ["stellar", "--help"]
